{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "3.1",
  "description": "Block distracting websites during FocusPro focus sessions, synced with Firebase.",
  "permissions": ["tabs", "storage", "alarms", "declarativeNetRequest", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
      "js": ["focuspro-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
